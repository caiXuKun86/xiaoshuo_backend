<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kun.service.user.mapper.UserMapper">

    <!-- Mapper XML -->
    <select id="selectByUserIdForUpdate" resultType="com.kun.service.user.domain.User">
